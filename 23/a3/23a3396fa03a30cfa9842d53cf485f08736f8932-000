// 14 October 2026, 12:00 CEST: authenticate privately; initialize preferences, never invent a learner result.
import { readFile, writeFile } from 'node:fs/promises'
import assert from 'node:assert/strict'
const root='/Users/zenray/.claude/tmp/tmp-zenray-japanese'
const credentialSource=await readFile('/Users/zenray/.claude/Memory1/AGENTS.md','utf8')
const secret=credentialSource.match(/Mot de passe maître du drive ZenRayProgress\s*=\s*`([^`]+)`/)?.[1]
assert(secret,'Existing site credential unavailable')
const base='https://zenray-progress.pages.dev'
const headers={'x-zr-auth':secret}
async function request(path,body) {
 const response=await fetch(base+path,{headers:body?{...headers,'content-type':'application/json'}:headers,method:body?'POST':'GET',body:body?JSON.stringify(body):undefined,signal:AbortSignal.timeout(60000)})
 const value=await response.json()
 assert(response.ok&&!value.error,`Production request failed (${response.status}): ${value.error||'invalid response'}`)
 return value
}
const localHtml=await readFile('/Users/zenray/.codex/worktrees/japanese-progress/dist/index.html','utf8')
const localEntry=localHtml.match(/src="([^\"]*\/assets\/index-[^\"]+\.js)"/)?.[1]
const liveHtml=await(await fetch(base+'/',{signal:AbortSignal.timeout(20000)})).text()
const liveEntry=liveHtml.match(/src="([^\"]*\/assets\/index-[^\"]+\.js)"/)?.[1]
assert.equal(liveEntry,localEntry)
const catalogue=await request('/api/page?action=read&raw=1&path=Memory%2FJapanese%2FSite%2Fcorpus%2Fcatalogue.json')
const head=JSON.parse(catalogue.markdown)
assert.equal(head.cards.length,251)
const before=await request('/api/japanese')
const saved=await request('/api/japanese',{action:'preferences',eventId:'web-init-14-October-2026',updates:{level:'N4'}})
assert(saved.ok&&saved.commit)
const after=await request('/api/japanese')
assert.equal(after.state.preferences.level,'N4')
assert.deepEqual(after.state.progress,before.state.progress)
const denied=await fetch(base+'/api/japanese',{signal:AbortSignal.timeout(20000)})
assert.equal(denied.status,401)
const report={date:'14 October 2026',production:base,deployment:'8d6788ac',entry:liveEntry,release:head.release,cards:head.cards.length,
  preferencesCommit:saved.commit,preferencesReadBack:true,learnerProgressUnchanged:true,unauthenticatedStatus:denied.status,passed:true}
await writeFile(root+'/verification/StudyProductionReport.json',JSON.stringify(report,null,2)+'\n')
console.log(JSON.stringify(report))
