// 14 October 2026, 13:18 CEST: read only production proof; no learner exposure or grade is submitted.
import { readFile, writeFile } from 'node:fs/promises'
import assert from 'node:assert/strict'
const workshop = '/Users/zenray/.claude/tmp/tmp-zenray-japanese'
const credentialText = await readFile('/Users/zenray/.claude/Memory1/AGENTS.md', 'utf8')
const secret = credentialText.match(/Mot de passe maître du drive ZenRayProgress\s*=\s*`([^`]+)`/)?.[1]
assert(secret, 'Existing site credential unavailable')
const local = JSON.parse(await readFile('/Users/zenray/.claude/Memory1/Japanese/Site/corpus/catalogue.json', 'utf8'))
const response = await fetch('https://zenray-progress.pages.dev/api/page?action=read&raw=1&path=Memory%2FJapanese%2FSite%2Fcorpus%2Fcatalogue.json', {headers:{'x-zr-auth':secret},signal:AbortSignal.timeout(30000)})
assert(response.ok, `Production catalogue HTTP ${response.status}`)
const envelope = await response.json()
assert(!envelope.error && envelope.markdown, 'Production catalogue body missing')
const live = JSON.parse(envelope.markdown)
assert.equal(live.release, local.release)
assert.equal(live.cards.length, local.cards.length)
// 14 October 2026: prove all delivered teaching fields and approval hashes equal the verified local catalogue.
assert.deepEqual(live.cards, local.cards)
const added = live.cards.filter(record => record.id.startsWith('expand-'))
assert.equal(added.length, local.cards.filter(record => record.id.startsWith('expand-')).length)
assert(added.every(record => record.lessonValidation?.status === 'approved' && new Set(record.lessonValidation.reviewerIds).size >= 2))
const report = {date:'14 October 2026', release:live.release, curatedCards:live.cards.length, approvedNewCards:added.length, grammarCards:live.counts.grammar, exactTeachingContentMatch:true, productionRead:true, learnerWrite:false, passed:true}
await writeFile(workshop + '/verification/ExpansionProductionVerification.json', JSON.stringify(report,null,2)+'\n')
console.log(JSON.stringify(report))
