ACCENTS = str.maketrans('àâäéèêëîïôöùûüÿçœ', 'aaaeeeeiioouuuyco')


def normalized(text):
    return unicodedata.normalize('NFKC', str(text)).lower().replace('œ', 'oe').translate(ACCENTS)


def tokens(text):
    return set(re.findall(r"[\w]+", normalized(text), re.UNICODE))


# 12 October 2026: retain compatibility and supplementary kanji in character searches.
def is_japanese_character(character):
    return '\u3040' <= character <= '\u9fff' or '\uf900' <= character <= '\ufaff' or '\U00020000' <= character <= '\U000323af'


def bucket(text, count):
    value = 2166136261
    for char in text:
        value = ((value ^ ord(char)) * 16777619) & 0xffffffff
    return value % count


def read_json(path):
    return json.loads(Path(path).read_text())


def atomic_text(path, text):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(dir=path.parent, prefix='.' + path.name)
    try:
        with os.fdopen(fd, 'w') as handle:
            handle.write(text)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def atomic_json(path, data):
    atomic_text(path, json.dumps(data, ensure_ascii=False, separators=(',', ':')) + '\n')


def source(url, title, publisher, license_name):
    return {'url': url, 'title': title, 'publisher': publisher, 'checkedAt': DATE, 'license': license_name}


def validate(records):
    seen = set()
    for record in records:
        if not record.get('id') or record['id'] in seen:
            raise ValueError('Missing or duplicated record ID: ' + str(record.get('id')))
        seen.add(record['id'])
        for field in ['title', 'domain', 'explanationFr', 'sources']:
            if not record.get(field):
                raise ValueError(f"{record['id']}: missing {field}")
        if any(not item.get('url', '').startswith('https://') for item in record['sources']):
            raise ValueError(record['id'] + ': missing HTTPS source')
        if record.get('domain') == 'grammar' and record.get('level') not in ['N5','N4','N3','N2','N1','beyond']:
            raise ValueError(record['id'] + ': unknown grammar level')
        for example in record.get('examples', []):
            if not example.get('ja') or not example.get('fr'):
                raise ValueError(record['id'] + ': incomplete example')
    return seen


def render_record(record):
    revision_date = record.get('revisionDate', DATE)
    clean = lambda text: str(text).replace('|', '\\|').replace('\n', ' ')
    lines = [f"## {record['id']} : {record['title']} ({revision_date})", '',
             f"Domaine : {record['domain']} ; niveau : {record.get('level','non classé')} ; statut : {record.get('status','source-imported')}. ({revision_date})", '',
             record['explanationFr'] + f' ({revision_date})', '']
    if record.get('examples'):
        lines += ['| Japonais et lecture | Français |', '|---|---|']
        for example in record['examples']:
            ja = example['ja']
            if example.get('reading') and example['reading'] != ja:
                ja += ' (' + example['reading'] + ')'
            lines.append(f"| {clean(ja)} | {clean(example['fr'])} ({revision_date}) |")
        lines.append('')
    if record.get('prerequisites'):
        lines += ['Prérequis : ' + ', '.join(record['prerequisites']) + f'. ({revision_date})', '']
    for item in record['sources']:
        lines.append(f"- [{item.get('title',item['url'])}]({item['url']}) ; {item.get('publisher','source')} ; {item.get('license',item.get('reuse','droit à vérifier'))} ; vérifié : {item.get('checkedAt',DATE)}. ({revision_date})")
    lines.append('')
    return '\n'.join(lines)


def curated(research):
    records = []
    for directory in ['language', 'japan']:
        for filename in sorted((research / directory).glob('*.json')):
            payload = read_json(filename)
            items = payload if isinstance(payload, list) else payload.get('records', [])
            if not isinstance(items,list):
                continue
            for item in items:
                if isinstance(item, dict) and item.get('id') and item.get('explanationFr'):
                    item.setdefault('aliases', [])
                    item.setdefault('examples', [])
                    item.setdefault('prerequisites', [])
                    item.setdefault('status', 'research')
                    item['levelEstimated'] = item.get('level','') in ['N5','N4','N3','N2','N1']
                    item['origin'] = str(filename)
                    item['corpus'] = directory
                    records.append(item)
    ids = validate(records)
    missing = [(record['id'], prerequisite) for record in records for prerequisite in record.get('prerequisites',[]) if prerequisite not in ids]
    if missing:
        raise ValueError('Missing prerequisite links: ' + str(missing[:10]))
    return records


def dictionary_records(research, dataset_paths=None):
    dataset_paths = dataset_paths or read_json(WORKSHOP / "settings.json")["datasets"]
    directory = research / 'datasets'
    filename = directory / dataset_paths['dictionary']
    if filename.exists():
        data = read_json(filename)
        tags = data.get('tags', {})
        attribution = source('https://www.edrdg.org/wiki/JMdict-EDICT_Dictionary_Project.html', 'JMdict', 'EDRDG, James Breen and contributors; French: Jean-Marc Desperrier and internationalization contributors', 'Japanese/English: CC BY-SA 4.0; French: separate compiler copyright, Jean-Marc Desperrier and JMdict internationalization contributors')
        for word in data['words']:
            forms = [item['text'] for item in word.get('kanji', [])]
            readings = [item['text'] for item in word.get('kana', [])]
            meanings = []
            senses = []
            for sense in word.get('sense', []):
                glosses = [g for g in sense.get('gloss', []) if g['lang'] in ['fre', 'eng']]
                if not glosses:
                    continue
                senses.append({**sense, 'gloss': glosses})
                labels = [tags.get(t, t) for t in sense.get('partOfSpeech', []) + sense.get('misc', []) + sense.get('field', []) + sense.get('dialect', [])]
                text = '; '.join(('FR : ' if g['lang'] == 'fre' else 'EN : ') + g['text'] for g in glosses)
                if labels:
                    text += ' [' + ', '.join(labels) + ']'
                meanings.append(text)
            if not meanings:
                continue
            languages = sorted({g['lang'] for s in senses for g in s['gloss']})
            yield {'id': 'word-' + str(word['id']), 'title': (forms or readings)[0], 'aliases': list(dict.fromkeys(forms + readings)),
                   'domain': 'dictionary', 'level': 'unclassified', 'levelEstimated': False, 'status': 'source-imported',
                   'explanationFr': '\n\n'.join(meanings), 'glossLanguages': languages, 'senses': senses,
                   'examples': [], 'prerequisites': [], 'sources': [attribution], 'reading': ' / '.join(readings)}
    filename = directory / dataset_paths['kanji']
    if filename.exists():
        data = read_json(filename)
        attribution = source('https://www.edrdg.org/wiki/KANJIDIC_Project.html', 'KANJIDIC2', 'EDRDG and named contributors', 'CC BY-SA 4.0')
        for char in data['characters']:
            readings, meanings = [], []
            for group in (char.get('readingMeaning') or {}).get('groups', []):
                readings += [r['value'] for r in group.get('readings', []) if r['type'] in ['ja_on', 'ja_kun']]
                meanings += [('FR : ' if m['lang'] == 'fr' else 'EN : ') + m['value'] for m in group.get('meanings', []) if m['lang'] in ['fr', 'en']]
            literal = char['literal']
            yield {'id': f'kanji-{ord(literal):05x}', 'title': literal, 'aliases': readings, 'domain': 'kanji',
                   'level': 'unclassified', 'status': 'source-imported', 'meaningLanguages': sorted({m['lang'] for g in (char.get('readingMeaning') or {}).get('groups',[]) for m in g.get('meanings',[]) if m['lang'] in ['fr','en']}), 'radicals': char.get('radicals',[]), 'explanationFr': '; '.join(meanings) or 'Sens français et anglais absent de la source.',
                   'examples': [], 'reading': ' / '.join(readings), 'prerequisites': [], 'misc': char.get('misc', {}),
                   'sources': [attribution], 'strokeFile': f'strokes/{ord(literal):05x}.svg' if (directory / 'strokes' / f'{ord(literal):05x}.svg').exists() else None}
    filename = directory / dataset_paths['sentences']
    if filename.exists():
        for line in filename.open():
            pair = json.loads(line)
            jp, fr = pair['japanese'], pair['french']
            yield {'id': f"sentence-{jp['id']}-{fr['id']}", 'title': jp['text'], 'aliases': [],
                   'domain': 'sentence', 'level': 'unclassified', 'status': 'community-unreviewed',
                   'explanationFr': fr['text'], 'examples': [{'ja': jp['text'], 'fr': fr['text']}],
                   'prerequisites': [], 'original': pair,
                   'sources': [source(item['url'], f"Tatoeba {item['id']}", item['author'] or 'anonymous contributor', 'CC BY 2.0 FR') for item in [jp,fr]]}


