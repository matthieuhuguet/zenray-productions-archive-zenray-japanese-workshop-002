    {
      "record": {
        "id": "expand-predicate-alternatives-ka",
        "title": "か : proposer des alternatives verbales ou adjectivales",
        "domain": "grammar",
        "level": "N5",
        "levelBasis": "Local editorial estimate; not an official JLPT item allocation",
        "aliases": [
          "か",
          "predicate-alternatives-ka"
        ],
        "explanationFr": "か peut relier des alternatives nominales, verbales ou adjectivales : 行くか帰るか, 高いか安いか. Dans une proposition intégrée, utiliser les prédicats neutres ; un nom ou une base adjectivale en な affirmatif non passé ne prend pas un だ supplémentaire avant ce か : 安全か危険か. La phrase intégrée peut ensuite dépendre de 考える ou 決める. Une succession en ますか ou ですか peut en revanche poser des questions polies autonomes, sans jouer exactement le même rôle de liste intégrée.",
        "frenchLearnerTrap": "行きますか、帰りますか peut adresser deux questions ; ne pas le traiter comme la même structure intégrée que 行くか帰るか考える.",
        "examples": [
          {
            "ja": "今日は歩くか走るか考えています。",
            "reading": "きょうはあるくかはしるかかんがえています。",
            "fr": "Je réfléchis à marcher ou à courir aujourd'hui.",
            "origin": "Original example; independent adversarial review pending"
          },
          {
            "ja": "この部屋が安全か危険か調べます。",
            "reading": "このへやがあんぜんかきけんかしらべます。",
            "fr": "Je vérifie si cette chambre est sûre ou dangereuse.",
            "origin": "Original example; independent adversarial review pending"
          }
        ],
        "prerequisites": [
          "expand-plain-question-ka",
          "expand-verb-dictionary-nonpast",
          "expand-na-adjective-predicate",
          "grammar-progressive",
